# Backend Port
PORT=3001
MAX_PARTICIPANTS=10
ROOM_TTL_MS=14400000

# Frontend environment
# Kosongkan agar otomatis menggunakan proxy Vite / origin saat ini (mendukung localhost & IP LAN/HP)
VITE_SOCKET_URL=

# STUN / TURN
# Default Google STUN is used if empty
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN (required for production / different NAT)
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
