{
  "name": "live-photobooth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "tunnel": "localtunnel --port 5173 --local-https --allow-invalid-cert",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.43.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.29.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@esbuild/darwin-x64": "^0.28.2",
    "@rollup/rollup-darwin-x64": "^4.63.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "localtunnel": "^2.0.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
